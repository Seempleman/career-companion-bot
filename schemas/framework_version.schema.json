{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career Companion Bot Installed Framework",
  "type": "object",
  "required": [
    "version",
    "official_repository",
    "source_commit",
    "installed_at"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "official_repository": {
      "type": "string"
    },
    "source_commit": {
      "type": "string"
    },
    "installed_at": {
      "type": "string"
    },
    "verified_signature": {
      "type": "boolean"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
